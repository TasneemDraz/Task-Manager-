# Copy to .env and adjust. docker compose reads .env automatically;
# without it, the defaults in docker-compose.yml are used (local demo only).

# --- Database ---
POSTGRES_DB=taskmanager
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=taskmanager
# Used by the API (docker compose builds DB_URL from the values above)
DB_URL=jdbc:postgresql://localhost:5432/taskmanager
DB_USERNAME=taskmanager
DB_PASSWORD=taskmanager

# --- JWT ---
# Base64-encoded secret, at least 32 bytes. Generate one with: openssl rand -base64 32
JWT_SECRET=replace-with-output-of-openssl-rand-base64-32
# ISO-8601 duration
JWT_EXPIRATION=PT24H

# --- Seeded admin (created by Flyway on first start; avoid single quotes in the password) ---
ADMIN_EMAIL=admin@taskmanager.local
ADMIN_PASSWORD=ChangeMe123

# --- CORS (comma-separated) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200
